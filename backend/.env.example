PORT=8080
DB_URL=postgres://devuser:devpassword@localhost:5433/music_db?sslmode=disable
# REQUIRED: 32+ byte random secret used to sign JWTs. The API refuses to start if empty.
# Generate one with PowerShell:
#   -join ((1..64) | ForEach-Object { '{0:x}' -f (Get-Random -Maximum 16) })
JWT_SECRET=
JWT_EXPIRY_HOURS=24
# Lifetime of a refresh token in hours (default 168 = 7 days). Each rotation
# issues a fresh token with this lifetime. Refuses to start if not a positive
# integer.
REFRESH_TOKEN_TTL_HOURS=168
BCRYPT_COST=10
